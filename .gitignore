# ---------------------------------------------------------------------------
# SQLite database
# chat.sqlite is generated by the app on the first request (see
# app/Routers/Database.class.php). WAL/SHM/journal files appear next to it while
# the database is in use, so they are ignored as well.
# ---------------------------------------------------------------------------
app/database/*.sqlite
app/database/*.sqlite-*
app/database/*.db
app/database/*.db-*
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------------
# Secrets and password files
# Never commit credentials, local environment values or exported password lists.
# ---------------------------------------------------------------------------
.env
.env.*
*.env
*.password
*.passwords
passwords.txt
*.pwd
credentials.json

# ---------------------------------------------------------------------------
# Temporary and log files
# ---------------------------------------------------------------------------
*.log
php_errors.log
*.tmp
*.temp
*.bak
*.orig
*.swp
*~
.DS_Store
Thumbs.db
.history/

# ---------------------------------------------------------------------------
# Editor / IDE folders
# ---------------------------------------------------------------------------
.idea/
.vscode/
*.sublime-*
